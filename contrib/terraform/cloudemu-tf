#!/bin/sh
# cloudemu-tf — run Terraform / OpenTofu against a running CloudEmu, with no
# provider boilerplate. It writes a provider override that points the AWS
# endpoints at CloudEmu and supplies dummy credentials, then execs the real
# `tofu` (preferred) or `terraform` binary with whatever arguments you pass.
#
# Usage (from a directory holding your .tf files):
#   cloudemu serve &                     # CloudEmu on :4566
#   cloudemu-tf init
#   cloudemu-tf apply
#
# Your config needs only an empty `provider "aws" {}` block (the override fills
# in endpoints, credentials and the path-style/skip flags). Configure via env:
#   CLOUDEMU_ENDPOINT   CloudEmu AWS endpoint      (default http://localhost:4566)
#   AWS_REGION          region to report           (default us-east-1)
#   CLOUDEMU_TF_BIN     force a specific binary     (default: tofu, then terraform)
set -eu

endpoint="${CLOUDEMU_ENDPOINT:-http://localhost:4566}"
region="${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}"

# Pick the runner: an explicit override, else OpenTofu, else Terraform.
if [ -n "${CLOUDEMU_TF_BIN:-}" ]; then
	bin="$CLOUDEMU_TF_BIN"
elif command -v tofu >/dev/null 2>&1; then
	bin="tofu"
elif command -v terraform >/dev/null 2>&1; then
	bin="terraform"
else
	echo "cloudemu-tf: no 'tofu' or 'terraform' binary on PATH" >&2
	exit 1
fi

# The config directory is the -chdir target if given, else the working dir. The
# override has to land next to the .tf files terraform actually loads.
dir="."
for arg in "$@"; do
	case "$arg" in
		-chdir=*) dir="${arg#-chdir=}" ;;
	esac
done

# Endpoints for the AWS services CloudEmu serves. Pointing an unused service
# here is harmless; add more keys as your config needs them.
override="$dir/cloudemu_providers_override.tf"
cat >"$override" <<EOF
# Generated by cloudemu-tf. Points the AWS provider at CloudEmu. Safe to delete.
provider "aws" {
  access_key = "test"
  secret_key = "test"
  region     = "$region"

  s3_use_path_style           = true
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true

  endpoints {
    s3             = "$endpoint"
    dynamodb       = "$endpoint"
    iam            = "$endpoint"
    sts            = "$endpoint"
    ec2            = "$endpoint"
    sqs            = "$endpoint"
    sns            = "$endpoint"
    lambda         = "$endpoint"
    secretsmanager = "$endpoint"
    kms            = "$endpoint"
    ssm            = "$endpoint"
    cloudwatch     = "$endpoint"
    cloudwatchlogs = "$endpoint"
    ecr            = "$endpoint"
    route53        = "$endpoint"
    rds            = "$endpoint"
    kinesis        = "$endpoint"
    sfn            = "$endpoint"
    eventbridge    = "$endpoint"
    elbv2          = "$endpoint"
  }
}
EOF

# Dummy credentials so the SDK's chain never reaches the real metadata service.
export AWS_ACCESS_KEY_ID="${AWS_ACCESS_KEY_ID:-test}"
export AWS_SECRET_ACCESS_KEY="${AWS_SECRET_ACCESS_KEY:-test}"
export AWS_REGION="$region"
export AWS_DEFAULT_REGION="$region"

exec "$bin" "$@"
